# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored so your keys never get committed.
#
# Get your credentials from https://www.etsy.com/developers → your app page.

# Your Etsy app keystring (public part of the key).
ETSY_KEYSTRING=

# Your Etsy app shared secret. Server-side only — never exposed to the browser.
ETSY_SHARED_SECRET=

# Optional: set to "true" to force sample data even when keys are present.
ETSY_FORCE_MOCK=
